# Copy this file to .env on the backend private EC2 instance and fill in real values.
# Never commit the real .env file.

PORT=5000
NODE_ENV=production

# RDS MySQL connection (use the RDS endpoint, not a public IP)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change_me
DB_NAME=vehicle_marketplace

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
# (the internal load balancer / frontend domain)
CORS_ORIGIN=http://internal-lb.example.local

# Where uploaded vehicle photos are stored on disk before being served
UPLOAD_DIR=uploads
